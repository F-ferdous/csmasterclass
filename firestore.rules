rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins: the owner account below (keep in sync with lib/admins.ts), plus any user
    // whose users/{uid} document has role == "admin" (set in the Firebase console).
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in ['admin@cs-masterclass.com']
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function validEmail(e) {
      return e is string && e.size() < 255 && e.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // ── Accounts ───────────────────────────────────────────────
    // Admin accounts only (Firebase Auth). Students are in students/{id} and have no Firebase login:
    // the website's server reads and writes their data for them (app/student-data.ts), so every
    // student collection below is admin-only from the browser. "signedIn()" therefore means an admin.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // One record per confirmed student (created on the server when an admin confirms a registration).
    // Students sign in on the server with their email + mobile number. students/{id}/private/ held the
    // old password hashes (no longer used) — no browser may ever read it.
    match /students/{id} {
      allow read, write: if isAdmin();

      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // Failed sign-in counters (brute-force protection). Server only.
    match /loginAttempts/{id} {
      allow read, write: if false;
    }

    // ── Coaching ───────────────────────────────────────────────
    match /locations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations and batch-change requests — written by the server, decided by admins.
    match /enrollments/{id} {
      allow read, write: if isAdmin();
    }

    // Scrypt password hashes for registrations awaiting a decision. Server only.
    match /enrollmentSecrets/{id} {
      allow read, write: if false;
    }

    // Class registers: attendance/{batchId}_{date}. Holds every student in the batch, so admins only.
    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

    // Homework and each student's submission (doc id = student id).
    match /homework/{id} {
      allow read, write: if isAdmin();

      match /submissions/{uid} {
        allow read, write: if isAdmin();
      }
    }

    // Per-student documents: revision trackers, push subscriptions, attendance and result copies.
    match /syllabusProgress/{uid} {
      allow read, write: if isAdmin();
    }

    match /pastPapers/{uid} {
      allow read, write: if isAdmin();
    }

    match /pushSubscriptions/{uid} {
      allow read, write: if isAdmin();
    }

    match /studentAttendance/{uid} {
      allow read, write: if isAdmin();
    }

    match /studentResults/{uid} {
      allow read, write: if isAdmin();
    }

    // Tests with every student's marks, and the parent-report log.
    match /tests/{id} {
      allow read, write: if isAdmin();
    }

    match /parentReports/{id} {
      allow read, write: if isAdmin();
    }

    match /announcements/{id} {
      allow read, write: if isAdmin();
    }

    match /resources/{id} {
      allow read, write: if isAdmin();
    }

    // Free material on the public /free-resources page. Anyone may read the visible ones
    // (queries must filter visible == true); hidden ones are admin-only.
    match /freeResources/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{id} {
      allow read, write: if isAdmin();
    }

    // ── Publishing ─────────────────────────────────────────────
    match /books/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ─────────────────────────────────────────────────
    // Website order form: anyone can place a well-formed new, unpaid order (prices are
    // re-checked by an admin before confirming). Signed-in students' orders come from the server.
    function validWebOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ref', 'uid', 'name', 'phone', 'email', 'address', 'note', 'items', 'subtotal',
          'deliveryFee', 'discount', 'status', 'source', 'paymentStatus', 'createdAt'])
        && d.ref is string && d.ref.size() > 0 && d.ref.size() <= 24
        && d.uid == ''
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
        && d.email is string && d.email.size() <= 200
        && d.address is string && d.address.size() <= 500
        && d.note is string && d.note.size() <= 1000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 20
        && d.subtotal is number && d.subtotal >= 0 && d.subtotal <= 1000000
        && d.deliveryFee == 0 && d.discount == 0
        && d.status == 'new' && d.source == 'website' && d.paymentStatus == 'unpaid'
        && d.createdAt == request.time;
    }

    match /orders/{id} {
      allow create: if isAdmin() || validWebOrder();
      allow read, update, delete: if isAdmin();
    }

    // ── Inbox ──────────────────────────────────────────────────
    // Contact form: anyone can create a well-formed message; only admins can read.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && validEmail(request.resource.data.email)
        && request.resource.data.topic is string && request.resource.data.topic.size() < 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Newsletter sign-ups.
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}

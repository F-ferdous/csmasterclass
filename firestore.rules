rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins: the owner account below (keep in sync with lib/admins.ts), plus any user
    // whose users/{uid} document has role == "admin" (set in the Firebase console).
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in ['admin@cs-masterclass.com']
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function validEmail(e) {
      return e is string && e.size() < 255 && e.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // ── Accounts ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Student profiles are created on the server when an admin confirms a registration
      // (app/student-actions.ts); only admins create them from the browser.
      allow create: if isAdmin();

      // Students may change only their name and parent's phone. Class, centre, batch (what decides
      // which materials they see), sign-in phone and role are set by admins.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'parentPhone', 'photoURL', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // ── Coaching ───────────────────────────────────────────────
    match /locations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Seat requests. New students' registrations are written by the server (uid ""), so the
    // browser can only add batch-change requests for an existing account. Only admins decide.
    match /enrollments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'classLevel', 'locationId', 'batchId', 'status', 'source', 'note', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'profile'
        && request.resource.data.note == ''
        && exists(/databases/$(database)/documents/batches/$(request.resource.data.batchId))
      );

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // Scrypt password hashes for registrations awaiting a decision. Server only.
    match /enrollmentSecrets/{id} {
      allow read, write: if false;
    }

    // Class registers: attendance/{batchId}_{date}. Holds every student in the batch, so admins only.
    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

    // Homework for batches (audienceKeys "batch:<id>", empty while hidden — same check as resources).
    function canSeeHomework(id) {
      return get(/databases/$(database)/documents/homework/$(id)).data.audienceKeys.hasAny(myAudienceKeys());
    }

    match /homework/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.audienceKeys.hasAny(myAudienceKeys()));
      allow write: if isAdmin();

      // One submission per student (doc id = their uid). Students edit their answer until it's marked;
      // only admins set mark / feedback / markedAt.
      match /submissions/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if isAdmin() || (
          signedIn() && request.auth.uid == uid && canSeeHomework(id)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'link', 'note', 'file', 'submittedAt', 'updatedAt'])
          && request.resource.data.uid == uid
        );
        allow update: if isAdmin() || (
          signedIn() && request.auth.uid == uid && canSeeHomework(id)
          && resource.data.get('markedAt', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'link', 'note', 'file', 'submittedAt', 'updatedAt'])
        );
        allow delete: if isAdmin();
      }
    }

    // Revision trackers, written by the student themselves.
    match /syllabusProgress/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['topics', 'updatedAt']));
    }

    match /pastPapers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['papers', 'updatedAt']));
    }

    // Web push subscriptions for each student's devices (endpoint + keys), used to send notifications.
    match /pushSubscriptions/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['subs', 'updatedAt']));
    }

    // Each student's own attendance and published test results (copied from the admin-only
    // registers and tests/{id}, which hold the whole batch).
    match /studentAttendance/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /studentResults/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Tests with every student's marks, and the parent-report log. Admins only.
    match /tests/{id} {
      allow read, write: if isAdmin();
    }

    match /parentReports/{id} {
      allow read, write: if isAdmin();
    }

    // Notices for students. Signed-in users see published ones (audience is filtered in the app);
    // drafts are admin-only.
    match /announcements/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'published');
      allow write: if isAdmin();
    }

    // Study materials. A student can read only items whose audienceKeys include one of theirs
    // ("all", "class:10", "batch:<id>", "location:<id>"). Hidden items have no keys, so never match.
    function myAudienceKeys() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ['all', 'class:' + p.get('classLevel', ''), 'batch:' + p.get('batchId', ''), 'location:' + p.get('locationId', '')];
    }

    match /resources/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.audienceKeys.hasAny(myAudienceKeys()));
      allow write: if isAdmin();
    }

    // Money received, recorded by admins. Students can see only their own payments.
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Publishing ─────────────────────────────────────────────
    match /books/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Inbox ──────────────────────────────────────────────────
    // Contact form: anyone can create a well-formed message; only admins can read.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && validEmail(request.resource.data.email)
        && request.resource.data.topic is string && request.resource.data.topic.size() < 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Newsletter sign-ups.
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}

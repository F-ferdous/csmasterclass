rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same admin definition as firestore.rules.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['admin@cs-masterclass.com']
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /covers/{file} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Study material files: resources/{resourceId}/{file}. Students have no Firebase login — they
    // download through the website's server (app/api/student/files), which checks the audience.
    match /resources/{resourceId}/{file} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/html.*')
          || request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\..*|vnd\\.ms-.*)')
          || request.resource.contentType == 'text/plain');
      allow delete: if isAdmin();
    }

    // Free resources: free-resources/{resourceId}/{file}. Visitors open them with the download
    // link saved on the freeResources doc (only readable while the doc is visible). HTML pages have
    // no saved link — the website serves them to its viewer (app/api/free-files).
    match /free-resources/{resourceId}/{file} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/html.*')
          || request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\..*|vnd\\.ms-.*)')
          || request.resource.contentType == 'text/plain');
      allow delete: if isAdmin();
    }

    // Homework answers: homework/{homeworkId}/{studentId}/{file}. Uploaded by the server for the
    // student; admins open them from the dashboard.
    match /homework/{homeworkId}/{uid}/{file} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }
  }
}
